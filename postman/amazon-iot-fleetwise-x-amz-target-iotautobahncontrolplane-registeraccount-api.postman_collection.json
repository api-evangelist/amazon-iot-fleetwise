              "raw": "{\n  \"timestreamResources\": {\n    \"timestreamDatabaseName\": \"0mFPBLesY\",\n    \"timestreamTableName\": \"8NaWylWxi\"\n  },\n  \"iamResources\": {\n    \"roleArn\": \"arn:awsSD:iam:::role/0FCryatOW\"\n  }\n}",
